import KiknadzeKrasnov.SwirlExtrema
import Mathlib.MeasureTheory.Integral.Gamma

namespace KiknadzeKrasnov

noncomputable section

open Set MeasureTheory
open scoped BigOperators

/-- Manuscript Eq. (95): enstrophy per unit axial length. -/
def enstrophyPerUnitLength (omega : ℝ → ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∫ r in Ioi (0 : ℝ), omega r ^ 2 * (2 * Real.pi * r)

/-- Gamma integral generated by a pair of distributed vorticity modes after the exact
radial change of variables. -/
def enstrophyKernelIntegral (s B : ℝ) : ℝ :=
  ∫ x in Ioi (0 : ℝ), x ^ (2 * s - 2) * Real.exp (-(B * x))

/-- The pairwise enstrophy kernel is finite and evaluates in closed form precisely on the
paper's admissible branch `s>1/2`, for positive combined inverse scale `B`. -/
theorem enstrophyKernelIntegral_eq
    {s B : ℝ} (hs : (1 / 2 : ℝ) < s) (hB : 0 < B) :
    enstrophyKernelIntegral s B =
      (1 / B) ^ (2 * s - 1) * gammaFn (2 * s - 1) := by
  have ha : 0 < 2 * s - 1 := by linarith
  have h := Real.integral_rpow_mul_exp_neg_mul_Ioi
    (a := 2 * s - 1) (r := B) ha hB
  unfold enstrophyKernelIntegral
  rw [show 2 * s - 2 = (2 * s - 1) - 1 by ring]
  simpa [gammaFn] using h

/-- Denominator form used in manuscript Eq. (96). -/
theorem enstrophyKernelIntegral_eq_div
    {s B : ℝ} (hs : (1 / 2 : ℝ) < s) (hB : 0 < B) :
    enstrophyKernelIntegral s B =
      gammaFn (2 * s - 1) / B ^ (2 * s - 1) := by
  rw [enstrophyKernelIntegral_eq hs hB]
  rw [one_div, Real.inv_rpow hB.le]
  field_simp [Real.rpow_pos_of_pos hB (2 * s - 1) |>.ne']

/-- The near-axis power in the enstrophy kernel is locally integrable exactly for `s>1/2`. -/
theorem enstrophy_axis_power_integrable_iff {s : ℝ} :
    IntegrableOn (fun x : ℝ => x ^ (2 * s - 2)) (Ioo 0 1) ↔
      (1 / 2 : ℝ) < s := by
  rw [intervalIntegral.integrableOn_Ioo_rpow_iff zero_lt_one]
  constructor <;> intro h <;> linarith

/-- One `(i,j)` contribution to the manuscript multimode enstrophy formula (96). -/
def enstrophyPairClosed
    (circI circJ s betaI betaJ : ℝ) : ℝ :=
  gammaFn (2 * s - 1) / (2 * Real.pi * gammaFn s ^ 2) *
    (circI * circJ * (betaI * betaJ) ^ s /
      (betaI + betaJ) ^ (2 * s - 1))

/-- One pair contribution after the exact radial substitution used to derive Eq. (96). -/
def enstrophyPairReduced
    (circI circJ s betaI betaJ : ℝ) : ℝ :=
  circI * circJ * (betaI * betaJ) ^ s /
      (2 * Real.pi * gammaFn s ^ 2) *
    enstrophyKernelIntegral s (betaI + betaJ)

/-- Evaluation of the reduced pair integral gives exactly the `(i,j)` term in Eq. (96). -/
theorem enstrophyPairReduced_eq_closed
    {circI circJ s betaI betaJ : ℝ}
    (hs : (1 / 2 : ℝ) < s) (hbetaI : 0 < betaI) (hbetaJ : 0 < betaJ) :
    enstrophyPairReduced circI circJ s betaI betaJ =
      enstrophyPairClosed circI circJ s betaI betaJ := by
  unfold enstrophyPairReduced enstrophyPairClosed
  rw [enstrophyKernelIntegral_eq_div hs (add_pos hbetaI hbetaJ)]
  ring

/-- Closed finite-mode enstrophy from manuscript Eq. (96). -/
def multimodeEnstrophyClosed {n : ℕ}
    (circ : Fin n → ℝ) (s : ℝ) (beta : Fin n → ℝ) : ℝ :=
  ∑ i, ∑ j, enstrophyPairClosed (circ i) (circ j) s (beta i) (beta j)

/-- The finite double sum of evaluated pair integrals is exactly Eq. (96). -/
theorem multimodeEnstrophyReduced_eq_closed {n : ℕ}
    {circ : Fin n → ℝ} {s : ℝ} {beta : Fin n → ℝ}
    (hs : (1 / 2 : ℝ) < s) (hbeta : ∀ i, 0 < beta i) :
    (∑ i, ∑ j, enstrophyPairReduced (circ i) (circ j) s (beta i) (beta j)) =
      multimodeEnstrophyClosed circ s beta := by
  classical
  unfold multimodeEnstrophyClosed
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  exact enstrophyPairReduced_eq_closed hs (hbeta i) (hbeta j)

/-- Single-mode enstrophy from manuscript Eq. (97). -/
def singleModeEnstrophyClosed (circ s beta : ℝ) : ℝ :=
  circ ^ 2 * beta * gammaFn (2 * s - 1) /
    (2 ^ (2 * s) * Real.pi * gammaFn s ^ 2)

/-- The diagonal `(i,i)` term of Eq. (96) reduces exactly to Eq. (97). -/
theorem enstrophyPairClosed_diagonal_eq_single
    {circ s beta : ℝ} (hs : (1 / 2 : ℝ) < s) (hbeta : 0 < beta) :
    enstrophyPairClosed circ circ s beta beta =
      singleModeEnstrophyClosed circ s beta := by
  unfold enstrophyPairClosed singleModeEnstrophyClosed
  have hs0 : 0 < s := by linarith
  have hbb : (beta * beta) ^ s = beta ^ (2 * s) := by
    rw [Real.mul_rpow hbeta.le hbeta.le]
    rw [← Real.rpow_add hbeta]
    congr 1
    ring
  have hadd : beta + beta = 2 * beta := by ring
  have h2b : (2 * beta) ^ (2 * s - 1) =
      (2 : ℝ) ^ (2 * s - 1) * beta ^ (2 * s - 1) := by
    exact Real.mul_rpow (by positivity) hbeta.le
  have hbetasplit : beta ^ (2 * s) = beta * beta ^ (2 * s - 1) := by
    calc
      beta ^ (2 * s) = beta ^ ((1 : ℝ) + (2 * s - 1)) := by congr 1; ring
      _ = beta ^ (1 : ℝ) * beta ^ (2 * s - 1) := Real.rpow_add hbeta 1 (2 * s - 1)
      _ = beta * beta ^ (2 * s - 1) := by rw [Real.rpow_one]
  have htwosplit : (2 : ℝ) ^ (2 * s) =
      2 * (2 : ℝ) ^ (2 * s - 1) := by
    calc
      (2 : ℝ) ^ (2 * s) = (2 : ℝ) ^ ((1 : ℝ) + (2 * s - 1)) := by congr 1; ring
      _ = (2 : ℝ) ^ (1 : ℝ) * (2 : ℝ) ^ (2 * s - 1) :=
        Real.rpow_add (by positivity) 1 (2 * s - 1)
      _ = 2 * (2 : ℝ) ^ (2 * s - 1) := by rw [Real.rpow_one]
  rw [hbb, hadd, h2b, hbetasplit, htwosplit]
  have hbpow : beta ^ (2 * s - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos hbeta (2 * s - 1)).ne'
  have h2pow : (2 : ℝ) ^ (2 * s - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos (by positivity) (2 * s - 1)).ne'
  field_simp [Real.pi_ne_zero, gammaFn_ne_zero hs0, hbpow, h2pow]

/-- The convergence threshold in Eq. (96) is algebraically identical to positivity of
`2s-1`, the gamma-integral shape parameter. -/
theorem enstrophy_threshold_iff {s : ℝ} :
    (1 / 2 : ℝ) < s ↔ 0 < 2 * s - 1 := by
  constructor <;> intro h <;> linarith

/-- Eq. (98): because single-mode enstrophy is linear in `beta`, the Riccati scale law
implies `Zdot=(a-4νβ)Z`. -/
theorem singleModeEnstrophy_hasDerivAt
    {circ s nu a betaDot t : ℝ} {beta : ℝ → ℝ}
    (_hs : (1 / 2 : ℝ) < s)
    (hbeta : HasDerivAt beta betaDot t)
    (hscale : betaScaleResidual nu a (beta t) betaDot = 0) :
    HasDerivAt (fun tau => singleModeEnstrophyClosed circ s (beta tau))
      ((a - 4 * nu * beta t) * singleModeEnstrophyClosed circ s (beta t)) t := by
  have hb := betaScaleResidual_zero_iff_rate.mp hscale
  unfold singleModeEnstrophyClosed
  have hconst := hbeta.const_mul
    (circ ^ 2 * gammaFn (2 * s - 1) /
      (2 ^ (2 * s) * Real.pi * gammaFn s ^ 2))
  convert hconst using 1
  · funext tau
    ring
  · rw [hb]
    ring

end

end KiknadzeKrasnov
